# PostgreSQL connection for local development and tests.
# Inside docker compose the host is `db`:
#   postgresql://dogfood:dogfood@db:5432/dogfood
DATABASE_URL=postgresql://dogfood:dogfood@localhost:5432/dogfood

# Separate database used by the test suite (reset via tests/fixtures/db.ts).
DATABASE_URL_TEST=postgresql://dogfood:dogfood@localhost:5432/dogfood_test

# Application port.
PORT=3000

# Open-link voting: hourly caps on minting new anonymous voter identities
# (per event, and per trusted network prefix when proxy headers are trusted).
# DOGFOOD_VOTING_LINK_EVENT_LIMIT_PER_HOUR=5000
# DOGFOOD_VOTING_LINK_NETWORK_LIMIT_PER_HOUR=200

# Base URL used for generated links (invitations, demo video, etc).
APP_URL=http://localhost:3000

# Ed25519 PKCS#8 PEM used to issue and revoke public judge participation records.
JUDGE_RECORD_SIGNING_PRIVATE_KEY=

# Comma-separated SHA-256 fingerprints of trusted Ed25519 SPKI keys.
# Obtain these fingerprints through an independent, authoritative channel.
# Empty means signatures can be checked, but issuer identity remains untrusted.
# The active key and these pins are published at /.well-known/dogfood-judge-records.json.
JUDGE_RECORD_TRUSTED_KEY_FINGERPRINTS=
